{
  "DSA main": {
    "prefix": "main",
    "body": [
      "#include <bits/stdc++.h>",
      "using namespace std;",
      "",
      "int main() {",
      "    ios::sync_with_stdio(false);",
      "    cin.tie(nullptr);",
      "",
      "    $1",
      "    return 0;",
      "}"
    ],
    "description": "main with fast I/O"
  },
  "DSA fastio": {
    "prefix": "fastio",
    "body": [
      "ios::sync_with_stdio(false);",
      "cin.tie(nullptr);",
      "$1"
    ],
    "description": "fast I/O boilerplate"
  },
  "DSA fori": {
    "prefix": "fori",
    "body": [
      "for (int ${1:i} = 0; ${1:i} < ${2:n}; ++${1:i}) {",
      "    $3",
      "}"
    ],
    "description": "index for loop"
  },
  "DSA vpai": {
    "prefix": "vpai",
    "body": [
      "vector<pair<${1:int}, ${2:int}>> ${3:v};$4"
    ],
    "description": "vector<pair<int,int>>"
  }
}
